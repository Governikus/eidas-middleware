{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Ignore Redhat and atlassin versions",
      "matchPackageNames": [
        "/.*/"
      ],
      "allowedVersions": "!/(redhat)|(atlassian)/"
    }
  ],
  "ignoreDeps": ["io.smallrye.common:smallrye-common-bom", "org.jboss.threads:jboss-threads", "com.sun.xml.ws:jaxws-rt", "com.sun.xml.bind:jaxb-impl"]
}
